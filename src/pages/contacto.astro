---
// TEAM_030: contacto «/contacto/» — SITE_SCRIPT contacto S00–S03.
// «Carta y fichero»: асимметрия 7/5 — карточка-письмо DmComposer (SSOT =
// sections.json.como-encargar.s02.composer, фрейминг заголовка/lede из
// contacto.s01) + rail «otros caminos» (Instagram / WhatsApp-статус /
// Datos rápidos) + фото-якорь 3:4. MF-3: S02 рендерится только при
// PUBLIC_FORM_ENDPOINT — без endpoint секции нет в HTML вообще.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DmComposer from '../components/DmComposer.astro';
import CutPic from '../components/CutPic.astro';
import site from '../data/sections.json';

const p = site.contacto;
const ig = site.global.brand;
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const [igCard, waCard, datosCard] = p.s01.rail;
// TEAM_045 Q1-21: превью-листок у заголовка — текст строго канон,
// тот же пример, что композит Redactor/noscript из sections.json.
const cm = site['como-encargar'].s02.composer;
const slipMsg = `Hola 👋 Quiero encargar ${cm.options[0].fill} para el día __. Soy __. ¿Me cuentas precio y opciones? ¡Gracias!`;
---

<Base title={p.meta.title} description={p.meta.description}>
	<Nav slot="header" />

	{/* S00+S01 — один экран «Carta y fichero»: слева заголовок S00 +
	     карточка-письмо (колонки 1–7), справа rail (8–12), фото-якорь внизу.
	     Mobile: заголовок → composer → Instagram → WhatsApp → datos → фото. */}
	<section data-section="S00+S01" class="carta" aria-labelledby="contacto-h">
		<div class="carta-grid mx-auto w-full max-w-6xl px-5">
			<div class="carta-main">
				<header class="carta-head">
					<p class="eyebrow" data-reveal>{p.s00.eyebrow}</p>
					<h1 id="contacto-h" class="font-display carta-h1" data-reveal>{p.s00.h1}</h1>
					<p class="carta-lede" data-reveal>{p.s00.lede}</p>
				</header>
				<div data-reveal>
					<DmComposer heading={p.s01.composer.title} lede={p.s01.composer.lede} />
				</div>
			</div>

			<aside class="rail" aria-label="Otros caminos">
				{/* TEAM_045 Q1-21: правая половина шапки была мертва —
				    мини-«черновик» DM (формат rd-preview) первым элементом
				    rail: показывает, как выглядит сообщение, до того как
				    пользователь дошёл до композитора. Дубль канона → aria-hidden. */}
				<aside class="carta-slip" aria-hidden="true" data-reveal>
					<span class="carta-slip-label">{cm.fields.mensaje}</span>
					<p class="carta-slip-msg hand-note">{slipMsg}</p>
					<span class="carta-slip-arrow">↓</span>
				</aside>
				<div class="rail-card rail-card--primary" data-reveal>
					{/* TEAM_039: честный статус канала типографикой, не иконкой.
					    TEAM_045 Q3-01: «principal» вне канона — убран; главный
					    рэйл подчёркнут кромкой/заливкой, без новых слов. */}
					<h2 class="rail-title">{igCard.title}</h2>
					<p class="rail-text">
						{igCard.text.replace(`${ig.handle} ↗`, '')}
						<a class="rail-link" href={igCard.href} target="_blank" rel="noopener">{ig.handle} ↗</a>
					</p>
				</div>
				<div class="rail-card" data-reveal>
					<h2 class="rail-title">{waCard.title}<span class="rail-tag">pendiente</span></h2>
					<p class="rail-text">{waCard.text}</p>
					<p class="rail-out">
						<a class="text-link" href={waCard.link.href} target="_blank" rel="noopener">{waCard.link.label}</a>
					</p>
				</div>
				<div class="rail-card" data-reveal>
					<h2 class="rail-title">{datosCard.title}</h2>
					<ul class="rail-chips" role="list">
						{datosCard.chips.map((c) => <li class="chip">{c}</li>)}
					</ul>
				</div>
				<figure class="rail-photo" data-reveal>
					{/* TEAM_045 Q1-14: рамка-обёртка — img абсолютится внутри
					    и не вносит свой рост в размер rail (иначе колонка
					    уходит ниже композитора). */}
					<div class="rail-photoframe">
						<CutPic
							name="rail-anchor"
							alt={p.s01.img_alt}
							sizes="(min-width: 64rem) 24vw, 78vw"
						/>
					</div>
					<figcaption class="hand-note rail-cap">{p.s01.photo_caption}</figcaption>
				</figure>
			</aside>
		</div>
	</section>

	{/* S02 — «¿Lo prefieres por escrito?». MF-3: секция существует
	     только при PUBLIC_FORM_ENDPOINT; без него S01 закрывает потребность
	     копируемым DM — секции в HTML нет вообще. */}
	{formEndpoint && (
		<section data-section="S02" class="nota-band" aria-labelledby="nota-h">
			<div class="nota-grid mx-auto w-full max-w-6xl px-5">
				<div class="nota-text">
					<h2 id="nota-h" class="font-display text-h2" data-reveal>{p.s02.h2}</h2>
					<p class="nota-explain" data-reveal>{p.s02.note_live}</p>
				</div>
				<form
					class="nota-card"
					data-contact-form
					action={formEndpoint}
					method="POST"
					aria-describedby="nota-note"
					data-statuses={JSON.stringify(p.s02.status)}
					data-reveal
				>
					<div class="nota-row">
						<label class="nota-field">
							<span class="nota-label">{p.s02.labels.nombre}</span>
							<input class="nota-input" type="text" name="nombre" autocomplete="name" placeholder="Marta" required />
						</label>
						<label class="nota-field">
							<span class="nota-label">{p.s02.labels.dia}</span>
							<input class="nota-input" type="date" name="fecha" />
						</label>
					</div>
					<label class="nota-field">
						<span class="nota-label">{p.s02.labels.mensaje}</span>
						<textarea
							class="nota-input"
							name="mensaje"
							rows={5}
							placeholder={p.s02.placeholder}
							required
						></textarea>
					</label>
					{/* Honeypot: invisible to humans, bots fill it → silent fake-success. */}
					<label class="nota-hp" aria-hidden="true">
						<span>Empresa</span>
						<input type="text" name="empresa" tabindex="-1" autocomplete="off" data-hp />
					</label>
					<div class="nota-actions">
						<button type="submit" class="btn" disabled aria-disabled="true" data-submit>{p.s02.button}</button>
						<p class="nota-status" role="status" aria-live="polite" data-form-status></p>
					</div>
					<p id="nota-note" class="nota-note">{p.s02.note_live}</p>
					<noscript>
						<p class="nota-note">{p.s02.noscript}</p>
					</noscript>
				</form>
			</div>
			<script is:inline>
				document.querySelectorAll('[data-contact-form]').forEach((el) => {
					const form = el;
					const submit = form.querySelector('[data-submit]');
					const status = form.querySelector('[data-form-status]');
					const hp = form.querySelector('[data-hp]');
					const st = JSON.parse(form.getAttribute('data-statuses') ?? '{}');

					submit.disabled = false;
					submit.removeAttribute('aria-disabled');

					const say = (msg, kind) => {
						status.textContent = msg;
						if (kind === 'info' || kind === undefined) delete status.dataset.kind;
						else status.dataset.kind = kind;
					};

					form.addEventListener('submit', async (e) => {
						e.preventDefault();
						if (hp.value) {
							say(st.sent ?? '');
							form.reset();
							return;
						}
						if (!form.checkValidity()) {
							form.reportValidity();
							return;
						}
						submit.disabled = true;
						say(st.sending ?? '…');
						try {
							const res = await fetch(form.action, {
								method: 'POST',
								body: new FormData(form),
								headers: { Accept: 'application/json' },
							});
							if (!res.ok) throw new Error(`HTTP ${res.status}`);
							say(st.sent ?? '');
							form.reset();
						} catch {
							say(st.fail ?? '', 'error');
						} finally {
							submit.disabled = false;
						}
					});
				});
			</script>
		</section>
	)}

	{/* S03 — salidas: рукописная строка-голос слева (рука 2/2) + ряд
	     трёх линк-выходов через «·». Без разделителя с меткой. */}
	<section data-section="S03" class="salidas" aria-label="Salidas">
		<div class="salidas-grid mx-auto w-full max-w-6xl px-5">
			<p class="hand-note salidas-voice" data-reveal>{p.s03.voice}</p>
			<p class="salidas-links" data-reveal>
				{p.s03.links.map((l, i) => (
					<>
						{i > 0 && <span class="salidas-dot" aria-hidden="true">·</span>}
						<a class="exit-link" href={l.href}>{l.label}</a>
					</>
				))}
			</p>
		</div>
	</section>

	<Footer slot="footer" />
</Base>

<style>
	/* — S00+S01 «Carta y fichero» — */
	.carta {
		/* TEAM_045 Q2-02: нижняя кромка 3.5rem→3rem — стек с S03 @390 = 96px */
		padding-block: clamp(3rem, 8vh, 5.5rem) clamp(3rem, 8vw, 6rem);
	}
	.carta-grid {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: start;
	}
	@media (min-width: 1024px) {
		/* TEAM_045 Q1-14: stretch — rail фото дотягивается до низа
		   левой колонки (композитор), низы колонок на одном ритме. */
		.carta-grid { grid-template-columns: 7fr 5fr; align-items: stretch; }
	}
	.carta-head { max-width: 46ch; }
	.carta-slip { display: none; }
	@media (min-width: 1024px) {
		/* TEAM_045 Q1-21: «черновик»-листок — миниатюра rd-preview:
		   пунктирная рамка, Caveat, лёгкий наклон, стрелка вниз. */
		.carta-slip {
			display: block;
			padding: 0.75rem 0.95rem 0.6rem;
			background: color-mix(in srgb, var(--bg) 82%, var(--surface));
			border: 1px dashed var(--color-muted);
			border-radius: 4px;
			box-shadow: var(--shadow-card);
			transform: rotate(1.2deg);
		}
		.carta-slip-label {
			font-family: var(--font-sans);
			font-weight: 500;
			font-size: 0.62rem;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			color: var(--color-muted-ink);
		}
		.carta-slip-msg {
			margin-top: 0.5rem;
			font-size: 1.12rem;
			line-height: 1.25;
		}
		.carta-slip-arrow {
			display: block;
			text-align: right;
			font-family: var(--font-hand);
			font-size: 1.4rem;
			color: var(--color-caramel-ink);
		}
	}
	.carta-h1 {
		font-weight: 560;
		font-variation-settings: "opsz" 72;
		font-size: var(--text-h1);
		line-height: 1.04;
		margin-top: 1.1rem;
	}
	.carta-lede {
		margin-top: 1.4rem;
		max-width: 52ch;
	}
	.carta-main .dm-composer { margin-top: clamp(2rem, 4vh, 3rem); }

	.rail {
		display: grid;
		gap: 1.1rem;
		align-content: start;
	}
	@media (min-width: 1024px) {
		/* TEAM_045 Q1-14: фото = резиновая строка — низ rail совпадает
		   с низом композитора слева. */
		.rail { grid-template-rows: auto auto auto auto minmax(0, 1fr); align-content: stretch; }
	}
	.rail-card {
		border: 1px solid color-mix(in srgb, var(--color-muted) 45%, transparent);
		border-radius: var(--radius-card);
		padding: 1rem 1.15rem;
	}
	/* TEAM_045 Q3-01: главный канал — карамельная кромка + тёплая
	   заливка вместо неканонного тега «principal». */
	.rail-card--primary {
		border-color: color-mix(in srgb, var(--color-caramel) 55%, transparent);
		background: color-mix(in srgb, var(--color-surface) 42%, transparent);
	}
	.rail-title {
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.72rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-caramel-ink);
		margin: 0;
		/* TEAM_039: статус-тег на одной базовой линии с заголовком */
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.6rem;
	}
	.rail-tag {
		font-weight: 400;
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: lowercase;
		color: var(--color-muted-ink);
		border: 1px solid color-mix(in srgb, var(--color-muted) 60%, transparent);
		border-radius: 999px;
		padding: 0.12rem 0.5rem 0.16rem;
		white-space: nowrap;
	}
	.rail-text {
		margin-top: 0.5rem;
		font-size: 0.92rem;
		color: var(--color-ink);
	}
	.rail-link {
		color: var(--color-caramel-ink);
		border-bottom: 1px solid currentColor;
		white-space: nowrap;
	}
	.rail-out { margin-top: 0.6rem; }
	.rail-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin-top: 0.75rem;
		list-style: none;
	}
	/* TEAM_039: «карточка на столе» — ассет rail-anchor уже несёт papel-поле
	   (край #EFE2D9); внешнюю плашку убираем — кромка и контактная тень живут
	   на самой карточке, подпись снаружи на «столе». */
	.rail-photo {
		margin: 0.4rem 0 0;
	}
	/* TEAM_030: img живёт внутри CutPic — cid родителя на него не вешается
	   (TOOLING), поэтому img — :global, фигура остаётся скоупленной. */
	.rail-photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid color-mix(in srgb, var(--color-muted) 45%, transparent);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-contact);
	}
	@media (min-width: 1024px) {
		/* TEAM_045 Q1-14: фигура тянется в остаток rail-строки; img
		   абсолютен в рамке (вне потока → ноль вклада в высоту), низ
		   rail ровно по низу композитора. object-fit кропит. */
		.rail-photo {
			display: flex;
			flex-direction: column;
			min-height: 14rem;
			margin-bottom: 0;
		}
		.rail-photoframe {
			position: relative;
			flex: 1;
			min-height: 8rem;
		}
		.rail-photoframe :global(img) {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
	}
	.rail-cap {
		padding: 0.55rem 0 0 0.2rem;
		font-size: 1.3rem;
	}

	/* — S02 «¿Lo prefieres por escrito?» — полоса --surface, 5/7 — */
	.nota-band {
		background: var(--surface);
		padding-block: clamp(3rem, 7vw, 5rem);
	}
	.nota-grid {
		display: grid;
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: start;
	}
	@media (min-width: 1024px) {
		.nota-grid { grid-template-columns: 5fr 7fr; }
	}
	.nota-explain {
		margin-top: 1.2rem;
		max-width: 44ch;
	}
	.nota-card {
		background: var(--bg);
		border: 1px solid color-mix(in srgb, var(--color-muted) 50%, transparent);
		border-radius: 6px;
		padding: clamp(1.25rem, 4vw, 2rem);
		display: grid;
		gap: 1.1rem;
		min-width: 0;
	}
	.nota-row {
		display: grid;
		gap: 1.1rem;
		min-width: 0;
	}
	@media (min-width: 640px) {
		.nota-row { grid-template-columns: 1fr 1fr; }
	}
	.nota-field { display: grid; gap: 0.35rem; min-width: 0; }
	.nota-label {
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.7rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--color-muted-ink);
	}
	.nota-input {
		font: inherit;
		padding: 0.6em 0.9em;
		border: 1px solid var(--color-muted-ink);
		border-radius: 4px;
		background: var(--surface);
		color: var(--color-ink);
		width: 100%;
		min-width: 0;
	}
	.nota-input:focus-visible { outline-color: var(--color-caramel-ink); }
	.nota-hp {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.nota-actions {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		flex-wrap: wrap;
	}
	.nota-actions .btn[disabled] { opacity: 0.55; cursor: not-allowed; }
	.nota-status { font-size: 0.9rem; color: var(--color-ink); margin: 0; }
	.nota-status[data-kind='error'] { color: var(--color-berry); }
	.nota-note {
		font-size: 0.85rem;
		color: var(--color-muted-ink);
		max-width: 46ch;
		margin: 0;
	}

	/* — S03 salidas — */
	.salidas {
		padding-block: clamp(3rem, 7vw, 5rem);
	}
	.salidas-grid {
		display: grid;
		gap: 1.4rem;
		align-items: baseline;
	}
	@media (min-width: 1024px) {
		.salidas-grid { grid-template-columns: 5fr 7fr; }
	}
	.salidas-voice { margin: 0; }
	.salidas-links {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.9rem;
		align-items: baseline;
	}
	.salidas-dot { color: var(--color-muted); }
	.exit-link {
		/* TEAM_045 Q2-01: hit-area 44px; underline → text-decoration. */
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.92rem;
		color: var(--color-caramel-ink);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.exit-link:hover { color: var(--color-berry); }
	@media (max-width: 640px) {
		.salidas-links { flex-direction: column; align-items: flex-start; }
		.salidas-dot { display: none; }
	}
</style>
