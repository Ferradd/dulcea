---
// TEAM_030: faq «/faq/» — SITE_SCRIPT faq S01–S03. «La mesa editorial»:
// интро 7/5 (eyebrow → H1 → intro → 3 факт-пилюли + фото-карточка «на
// столе»), аккордеон «notas» 8/4 + sticky-aside «¿No está tu pregunta?»,
// финальная панель-строка. Copy только из sections.json; фото через
// CutPic (intro-sticker / acordeon-aside из cut/).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CutPic from '../components/CutPic.astro';
import Faq from '../components/Faq.astro';
import site from '../data/sections.json';

const p = site.faq;
---

<Base title={p.meta.title} description={p.meta.description}>
	<Nav slot="header" />

	{/* S01 — intro + «respuestas rápidas»: grid 7/5, слева текст + 3
	     пилюли, справа фото-карточка «на столе» (hairline-рамка, без
	     полароида и наклона) + Caveat «contesto yo misma» (рука 1/2). */}
	<section data-section="S01" class="faq-intro" aria-labelledby="faq-h">
		<div class="intro-grid mx-auto w-full max-w-6xl px-5">
			<div class="intro-text">
				<p class="eyebrow" data-reveal>{p.s01.eyebrow}</p>
				<h1 id="faq-h" class="font-display intro-h1" data-reveal>{p.s01.h1}</h1>
				<p class="intro-lede" data-reveal>{p.s01.intro}</p>
				{/* TEAM_044 (Q4-03): пилюли → тихая facts-строка с «·»
				     сепараторами; текст канона не тронут. */}
				<ul class="intro-facts" role="list" data-reveal>
					{p.s01.chips.map((c) => <li>{c}</li>)}
				</ul>
			</div>
			<figure class="intro-photo" data-reveal>
				{/* TEAM_044 (Q1-12/Q1-13): дубль intro-sticker снят —
				     другая зона того же b/-листа (porción на салфетке). */}
				<CutPic
					name="filipinos-alt"
					alt={p.s01.img_alt}
					sizes="(min-width: 64rem) 26vw, 70vw"
				/>
				<figcaption class="hand-note intro-cap">{p.s01.photo_caption}</figcaption>
			</figure>
		</div>
	</section>

	{/* S02 — el acordeón: левая колонка ~8/12 — семь notas
	     (<details>/<summary> внутри Faq.astro), правая ~4/12 — sticky
	     aside «¿No está tu pregunta?» + CTA + фото queso с Caveat
	     (рука 2/2). Mobile: аккордеон → aside карточкой в конце. */}
	<section data-section="S02" class="acordeon" aria-label="Preguntas">
		<div class="ac-grid mx-auto w-full max-w-6xl px-5">
			<div class="ac-notes" data-reveal>
				<Faq items={p.s02.notas} />
			</div>
			<aside class="ac-aside" aria-label={p.s02.aside.title}>
				<div class="aside-card" data-reveal>
					<h2 class="aside-title">{p.s02.aside.title}</h2>
					<p class="aside-cta">
						<a class="btn" href={p.s02.aside.cta.href} target="_blank" rel="noopener">{p.s02.aside.cta.label}</a>
					</p>
					<figure class="aside-photo">
						{/* TEAM_044 (Q1-12/Q1-13): queso — «одна из текущих»
						     по канону секции → queso-entera-warm (тёплый). */}
						<CutPic
							name="queso-entera-warm"
							alt={p.s02.aside.img_alt}
							sizes="(min-width: 64rem) 19vw, 60vw"
						/>
						<figcaption class="hand-note aside-cap">{p.s02.aside.photo_caption}</figcaption>
					</figure>
				</div>
			</aside>
		</div>
	</section>

	{/* S03 — «¿Otra duda?»: широкая панель-строка на --surface, текст
	     7/5 по краям; mobile — столбик, кнопка на всю ширину. */}
	<section data-section="S03" class="faq-cierre" aria-label="Otra duda">
		<div class="mx-auto w-full max-w-6xl px-5">
			<div class="cierre-panel" data-reveal>
				<p class="font-display cierre-line">{p.s03.line}</p>
				<div class="cierre-ctas">
					<a class="btn" href={p.s03.cta.href} target="_blank" rel="noopener">{p.s03.cta.label}</a>
					<a class="exit-link" href={p.s03.quiet.href}>{p.s03.quiet.label}</a>
				</div>
			</div>
		</div>
	</section>

	<Footer slot="footer" />
</Base>

<style>
	/* TEAM_044 (Q1-22): якоря секций/аккордеона не должны уходить под
	   фикс-навбар (4.25rem) — как в tartas.astro. */
	section[id] { scroll-margin-top: 4.75rem; }

	/* — S01 intro — */
	.faq-intro {
		padding-block: clamp(3rem, 8vh, 5.5rem) clamp(2.5rem, 6vw, 4.5rem);
	}
	.intro-grid {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: start;
	}
	@media (min-width: 1024px) {
		.intro-grid { grid-template-columns: 7fr 5fr; }
	}
	.intro-h1 {
		font-weight: 560;
		font-variation-settings: "opsz" 72;
		font-size: var(--text-h1);
		line-height: 1.04;
		margin-top: 1.1rem;
	}
	.intro-lede {
		margin-top: 1.4rem;
		max-width: 50ch;
	}
	/* TEAM_044 (Q4-03): пилюли → lede-строка фактов: small caps,
	   сепаратор «·» caramel, без рамок-пилюль. */
	.intro-facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35em 0;
		padding: 0;
		margin-top: 1.7rem;
		list-style: none;
	}
	.intro-facts li {
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-muted-ink);
		display: flex;
		align-items: baseline;
	}
	.intro-facts li + li::before {
		content: "·";
		color: var(--color-caramel);
		margin: 0 0.9em;
	}
	/* TEAM_039: «карточка на столе» — ассет intro-sticker уже несёт papel-поле
	   (край #EFE2D9); внешнюю плашку убираем — кромка и контактная тень живут
	   на самой карточке, подпись снаружи на «столе». */
	.intro-photo {
		margin: 0;
		max-width: 24rem;
	}
	/* TEAM_030: img живёт внутри CutPic — cid родителя на него не вешается
	   (TOOLING), поэтому img — :global, фигура остаётся скоупленной. */
	.intro-photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid color-mix(in srgb, var(--color-muted) 45%, transparent);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-contact);
	}
	.intro-cap {
		padding: 0.55rem 0 0 0.2rem;
		font-size: 1.3rem;
	}
	@media (min-width: 1024px) {
		.intro-photo { justify-self: end; }
	}

	/* — S02 acordeón + sticky aside (grid 8/4) — */
	.acordeon {
		/* TEAM_039: верх подтянут — между intro и аккордеоном висел столб
		   пустого крема ~4.5rem+3.5rem на десктопе. */
		/* TEAM_044 (Q2-02): min pt 1.5rem — полоса S01→S02 @390 ≈64px. */
		padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(3rem, 7vw, 5rem);
	}
	/* TEAM_044 (Q1-14): концовка колонки notas — тик + hairline,
	   тихий слой-завершение списка. */
	.ac-notes::after {
		content: "";
		display: block;
		margin-top: 1.9rem;
		width: min(11rem, 45%);
		height: 6px;
		background:
			linear-gradient(90deg, var(--color-caramel-ink) 0 5px, transparent 5px),
			linear-gradient(
				transparent 2.5px,
				color-mix(in srgb, var(--color-muted) 55%, transparent) 2.5px,
				color-mix(in srgb, var(--color-muted) 55%, transparent) 3.5px,
				transparent 3.5px
			);
	}
	.ac-grid {
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: start;
	}
	@media (min-width: 1024px) {
		.ac-grid { grid-template-columns: 8fr 4fr; }
		.ac-aside {
			position: sticky;
			top: 5.5rem; /* sticky nav 4.25rem + воздух */
		}
	}
	.aside-card {
		border: 1px solid color-mix(in srgb, var(--color-muted) 50%, transparent);
		border-radius: var(--radius-card);
		/* TEAM_039: papel-карточка на столе — --surface, иначе заливка --bg
		   сливалась со страницей и карточка висела «призраком». */
		background: var(--surface);
		box-shadow: var(--shadow-contact);
		padding: 1.2rem;
	}
	.aside-title {
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 1rem;
		margin: 0;
	}
	.aside-cta { margin: 1rem 0 0; }
	/* TEAM_039: фото внутри papel-карточки — без второй рамки-плашки,
	   кромка + тень на самой карточке (ассет несёт запечённое поле). */
	.aside-photo {
		margin: 1.4rem 0 0;
	}
	.aside-photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid color-mix(in srgb, var(--color-muted) 40%, transparent);
		border-radius: calc(var(--radius-card) - 0.35rem);
	}
	.aside-cap {
		padding: 0.5rem 0 0 0.15rem;
		font-size: 1.25rem;
	}

	/* — S03 cierre-панель — */
	/* TEAM_044 (Q1-18 + Q2-02): цитата и кнопки сближены в центрированную
	   группу с hairline-связкой; pt отделяет панель от аккордеона. */
	.faq-cierre {
		padding-top: 1rem;
		padding-bottom: clamp(3rem, 7vw, 5rem);
	}
	.cierre-panel {
		background: var(--surface);
		border: 1px solid color-mix(in srgb, var(--color-muted) 45%, transparent);
		border-radius: var(--radius-card);
		padding: clamp(1.9rem, 4vw, 2.8rem);
		display: grid;
		justify-items: center;
		text-align: center;
	}
	.cierre-line {
		font-style: italic;
		font-weight: 500;
		font-size: var(--text-h3);
		line-height: 1.25;
		margin: 0;
		max-width: 32ch;
	}
	/* hairline-связка цитата→кнопки */
	.cierre-line::after {
		content: "";
		display: block;
		width: 1px;
		height: 1.7rem;
		margin: 1.3rem auto 0;
		background: color-mix(in srgb, var(--color-caramel) 75%, transparent);
	}
	.cierre-ctas {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.9rem 1.6rem;
		margin-top: 1.4rem;
	}
	@media (max-width: 640px) {
		.cierre-ctas { flex-direction: column; align-items: stretch; }
		.cierre-ctas .btn { width: 100%; justify-content: center; }
		.cierre-ctas .exit-link { align-self: center; }
	}
	.exit-link {
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.92rem;
		color: var(--color-caramel-ink);
		border-bottom: 1px solid currentColor;
		padding-bottom: 0.15em;
	}
	.exit-link:hover { color: var(--color-berry); }
</style>
