---
// TEAM_027: index «/» — SITE_SCRIPT S01–S06. «La mesa editorial»:
// «La barra» hero → strata band «la firma» → vitrina 2+1 → dark obrador
// reel → queso diptych → «tu porción» CTA. All copy from sections.json;
// all photos from src/assets/cut/ via CutPic (avif→webp→jpg, fixed dims).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CutPic from '../components/CutPic.astro';
import StrataBand from '../components/StrataBand.astro'; // TEAM_029: S02 wow-лента (kill-isolated)
import { getCut } from '../lib/cuts';
import site from '../data/sections.json';

const p = site.index;
const poster = getCut('reel-poster').webp.at(-1)!.url;
---

<Base title={p.meta.title} description={p.meta.description}>
	<Nav slot="header" />

	{/* S01 — hero «La barra»: the bakery counter. Photo-objects stand on
	     a shelf line (no mattes, contact shadows); the counter front is
	     the table edge the S02 panel slides onto. Layer 0 (G.5). TEAM_040 */}
	<section data-section="S01" class="hero" aria-labelledby="hero-h">
		<div class="hero-scene">
			<div class="hero-copy mx-auto w-full max-w-6xl px-5">
				<p class="eyebrow" data-reveal>{p.s01.eyebrow}</p>
				<h1 id="hero-h" class="font-display hero-h1" data-reveal>{p.s01.h1}<br /><em>{p.s01.emphasis}</em></h1>
				<p class="hero-lede" data-reveal>{p.s01.lede}</p>
				<div class="hero-ctas" data-reveal>
					<a class="btn" href={p.s01.cta_primary.href}>{p.s01.cta_primary.label} →</a>
					<a class="btn btn--ghost" href={p.s01.cta_secondary.href} target="_blank" rel="noopener">{p.s01.cta_secondary.label} ↗</a>
				</div>
				<div class="hero-facts"><span>Hechas por encargo</span><span>Recogida en Cartagena</span></div>
			</div>

			<div class="hero-shelf">
				{/* TEAM_043 (Q4-04): тихий слой в мёртвой нижней-левой
				     трети — рукописная пометка-эхо h1 + ручная стрелка
				     к линии прилавка (мостик к S02 «el corte») */}
				<div class="hero-floor">
					<span class="hero-floor-note hand-note">capa a capa</span>
					<svg class="hero-floor-arrow" viewBox="0 0 44 30" fill="none" aria-hidden="true">
						<path d="M4 3 C 14 7, 28 14, 36 24 M36 24 l-6.5-1.5 M36 24 l.5-7.5"/>
					</svg>
				</div>
				<figure class="hero-obj hero-obj--figura" data-reveal style="--d: 300ms;">
					<CutPic
						name="barritas-figura"
						alt={site.tartas.s04.img_alt_figura}
						sizes="16vw"
					/>
				</figure>
				<figure class="hero-obj hero-obj--main" data-reveal style="--d: 400ms;">
					<span class="hero-note hand-note" aria-hidden="true">la de Nocilla</span>
					<CutPic
						name="hero-card"
						alt={p.s01.img_alt}
						sizes="(min-width: 64rem) 23vw, 62vw"
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
				<figure class="hero-obj hero-obj--queso" data-reveal style="--d: 500ms;">
					<CutPic
						name="queso-shelf-porcion"
						alt={site.tartas.s05.img_alt_porcion}
						sizes="(min-width: 64rem) 12vw, 38vw"
					/>
					{/* TEAM_043 (Q2-06): вторая бирка-ценник — видна только
					     на shelf-композиции ≤1023px (см. стили ниже) */}
					<span class="hero-note hero-note--queso hand-note" aria-hidden="true">la de queso</span>
				</figure>
			</div>

			<div class="hero-counter" aria-hidden="true"></div>
		</div>
	</section>

	<div class="bakery-ribbon" aria-label="Los sabores de dulcea"><span>Obleas crujientes</span><span>Chocolate y Nocilla</span><span>Queso cremoso</span></div>
	<div class="flow">
		{/* S02 — «el corte / la firma»: text col left + full-width strata
		     band. Clean mount point for the W-worker's annotations. */}
		<section data-section="S02" class="panel seam s02" aria-labelledby="s02-h">
			<div class="mx-auto max-w-6xl px-5 pt-12 pb-12 md:pt-28">
				<div class="s02-wrap">
					<div class="s02-text">
						<p class="eyebrow" data-reveal>{p.s02.eyebrow}</p>
						<h2 id="s02-h" class="font-display text-h2" data-reveal>{p.s02.h2}</h2>
						<p class="s02-body" data-reveal>{p.s02.body}</p>
					</div>
					{/* TEAM_043 (Q1-02): малая деталь справа от абзаца —
					     ручной силуэт порции со слоями; сидит в зазоре перед
					     лентой и связывает текст с полосой среза */}
					<svg class="s02-aside" viewBox="0 0 76 58" fill="none" aria-hidden="true">
						<g stroke-linecap="round" stroke-linejoin="round">
							<path d="M10 46 L60 46 L60 22 C60 13 50 8 38 8 C22 8 10 22 10 46 Z" />
							<path d="M14 32 Q34 26 56 30" />
							<path d="M14 39 Q34 34 56 38" />
							<path d="M4 50 L72 50" />
						</g>
					</svg>
				</div>
			</div>
			<StrataBand alt={p.s02.img_alt} /> {/* TEAM_029: была inline-верстка .corte-band — вынесена в компонент (mount/kill-изоляция) */}
			<p class="band-note mx-auto max-w-6xl px-5 pt-4 pb-12 md:pb-20" data-reveal>{p.s02.caption}</p>
		</section>

		{/* S03 — «las de obleas»: vitrina. TEAM_043 (Q4-01/Q1-03/Q1-04):
		     не features-grid, а прилавок — принты стоят на общей полке
		     разной высоты, подписи-этикетки висят под линией, третье
		     место = пустой слот с пунктирным силуэтом торта. */}
		<section data-section="S03" class="panel surface-band" aria-labelledby="s03-h">
			<div class="mx-auto max-w-6xl px-5 py-12 md:py-24">
				<p class="eyebrow" data-reveal>{p.s03.eyebrow}</p>
				<h2 id="s03-h" class="font-display text-h2 mt-3" data-reveal>{p.s03.h2}</h2>

				<div class="vitrina mt-10">
					{p.s03.cards.map((c, i) => (
						<a href={c.href} class="vitrina-item" data-reveal>
							<span class:list={['vitrina-obj', i === 0 ? 'vitrina-obj--a' : 'vitrina-obj--b']}>
								<CutPic
									name={i === 0 ? 'card-1-nocilla-barritas' : 'card-2-filipinos'}
									alt={c.img_alt}
									sizes="(min-width: 64rem) 340px, 80vw"
								/>
							</span>
							<span class="vitrina-tag">
								<span class="flavor-name">{c.title}</span>
								<span class="flavor-text">{c.text}</span>
								<span class="cake-card-link">Ver la tarta <span aria-hidden="true">↗</span></span>
							</span>
						</a>
					))}
					<a href={p.s03.tile.href} class="vitrina-item vitrina-slot" data-reveal>
						<span class="vitrina-obj vitrina-obj--slot">
							<CutPic name="queso-shelf-entera" alt="Tarta de queso dorada, hecha en la cocina de dulcea" sizes="(min-width: 768px) 350px, 90vw" />
							{/* пунктирный силуэт торта — свободное место на полке */}
							<svg class="slot-cake" viewBox="0 0 120 96" fill="none" aria-hidden="true">
								<g stroke-linecap="round">
									<path d="M24 62 Q60 38 96 62" />
									<path d="M24 62 V70 Q60 82 96 70 V62" />
									<path d="M27 68 Q60 78 93 68" />
									<path d="M14 80 H106" />
									<path d="M40 86 H80" />
								</g>
							</svg>
						</span>
						<span class="vitrina-tag">
							<span class="tile-q font-display">{p.s03.tile.title}</span>
							<span class="flavor-text tile-line">{p.s03.tile.text}</span><span class="cake-card-link">Ver la tarta <span class="tile-arrow" aria-hidden="true">↗</span></span>
						</span>
					</a>
				</div>

				<p class="mt-10" data-reveal>
					<a class="text-link" href={p.s03.link.href}>{p.s03.link.label}</a>
				</p>
			</div>
		</section>

		{/* S04 — «en el obrador»: the single dark scene. Video 3:4 lazy,
		     poster-only under reduced motion, click = pause/play. */}
		<section data-section="S04" class="panel dark-scene" aria-labelledby="s04-h">
			{/* TEAM_038: strata strip along the bottom edge — real cut as
			     counter-surface texture, dimmed ~10% (redactor-tex pattern).
			     Wrapper div is native: scoped class must sit on an element
			     this template owns, not inside the CutPic component. */}
			<div class="obrador-tex">
				<CutPic
					name="corte-band"
					alt=""
					sizes="100vw"
				/>
			</div>
			<div class="obrador-grid mx-auto w-full max-w-6xl px-5 py-12 md:py-24">
				<div class="obrador-text">
					<p class="eyebrow eyebrow--dark" data-reveal>{p.s04.eyebrow}</p>
					<h2 id="s04-h" class="font-display text-h2 mt-3" data-reveal>{p.s04.h2}</h2>
					<p class="obrador-body" data-reveal>{p.s04.body}</p>
					<p class="hand-note obrador-quote" data-reveal>{p.s04.quote}</p>
				</div>
				<div class="reel-wrap" data-reveal>
					<div class="reel-frame">
						<video
							src="/video/reel.mp4"
							controls
							poster={poster}
							width="720"
							height="960"
							muted
							loop
							playsinline
							preload="none"
							aria-label={p.s04.video_label}
						></video>
						{/* TEAM_043 (Q4-05): play-аффорданс — бейдж виден только
						     когда reel на паузе (синк скриптом внизу страницы) */}
						<span class="reel-play" aria-hidden="true">
							<svg viewBox="0 0 12 14"><path d="M1 1 L11 7 L1 13 Z"/></svg>
						</span>
					</div>
				</div>
			</div>
		</section>

		{/* S05 — «la de queso»: back to cream; text 40% / overlapping
		     diptych 60% (single composite cut asset). */}
		<section data-section="S05" class="panel seam" aria-labelledby="s05-h">
			<div class="queso-grid mx-auto w-full max-w-6xl px-5 py-12 md:py-28">
				<div class="queso-text">
					<p class="eyebrow" data-reveal>{p.s05.eyebrow}</p>
					<h2 id="s05-h" class="font-display text-h2 mt-3" data-reveal>{p.s05.h2}</h2>
					<p class="queso-body" data-reveal>{p.s05.body}</p>
					{/* TEAM_043 (Q1-14): тихий слой в пустоте под текстом —
					     фирменная фраза с их же афиши + ручная волна */}
					<p class="queso-note hand-note" data-reveal>
						la favorita del barrio
						<svg class="queso-note-sw" viewBox="0 0 150 9" fill="none" aria-hidden="true">
							<path d="M3 5 Q22 1.5 42 4.5 T84 4.5 T124 4.5 T147 4" stroke-linecap="round"/>
						</svg>
					</p>
				</div>
				<figure class="queso-fig" data-reveal>
					<CutPic
						name="queso-diptych"
						alt={p.s05.img_alt}
						sizes="(min-width: 64rem) 56vw, 94vw"
					/>
					<figcaption class="caption mt-4">{p.s05.caption}</figcaption>
				</figure>
			</div>
		</section>

		{/* S06 — «tu porción»: steps-as-ruler. TEAM_043 (Q4-02/Q1-06/
		     Q1-14): шаги 01-03 = станции на горизонтальной линейке
		     во всю ширину (мотив «nota NN» из faq), фото — малый
		     якорь на конце линейки (приз после шага 03), не колонка.
		     mobile: та же линейка, повёрнутая вертикально. */}
		<section data-section="S06" class="panel" aria-labelledby="s06-h">
			<div class="mx-auto w-full max-w-6xl px-5 py-12 md:py-28">
				<p class="eyebrow" data-reveal>{p.s06.eyebrow}</p>
				<h2 id="s06-h" class="font-display text-h2 mt-3 porcion-h" data-reveal>{p.s06.h2}</h2>

				<div class="porcion-rulerwrap" data-reveal>
					<figure class="frame-card porcion-fig">
						{/* TEAM_043 (Q1-12/Q1-13): filipinos-alt от FX2 —
						     другая зона RAW-листа, разбивка повторов активов */}
						<CutPic
							name="filipinos-alt"
							alt={p.s06.img_alt}
							sizes="(min-width: 64rem) 190px, 60vw"
						/>
					</figure>
					<ol class="porcion-ruler">
						{p.s06.steps.map((s, i) => (
							<li>
								<span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
								<span class="step-txt">{s}</span>
							</li>
						))}
					</ol>
				</div>

				<div class="porcion-ctas" data-reveal>
					<a class="btn" href={p.s06.cta.href} target="_blank" rel="noopener">{p.s06.cta.label} ↗</a>
					<a class="text-link" href={p.s06.quiet_link.href}>{p.s06.quiet_link.label}</a>
				</div>
			</div>
		</section>
	</div>

	<Footer slot="footer" />
</Base>

<script>
	// TEAM_043: S04 reel — бейдж «play» виден только пока видео на
	// паузе (или до автозапуска IO); во время воспроизведения прячется.
	const reel = document.querySelector<HTMLVideoElement>('.reel-frame video');
	const reelPlay = document.querySelector('.reel-play');
	if (reel && reelPlay) {
		const syncReelBadge = () => reelPlay.classList.toggle('is-hidden', !reel.paused);
		reel.addEventListener('play', syncReelBadge);
		reel.addEventListener('pause', syncReelBadge);
		syncReelBadge();
	}
</script>

<style>
	/* — S01 «La barra»: photo-objects standing on the counter; the counter
	   front (--surface band) is the table the S02 panel slides onto.
	   TEAM_040 — */
	.hero {
		background: var(--bg);
	}
	.hero-scene {
		--counter-h: clamp(5.5rem, 13svh, 8rem);
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: calc(100svh - 4.25rem);
		padding-bottom: var(--counter-h);
		/* objects may bleed off the right edge — clip it to the viewport,
		   don't let it become page-level horizontal scroll */
		overflow-x: clip;
	}
	.hero-copy {
		position: relative;
		z-index: 2;
		padding-top: clamp(3rem, 9svh, 6rem);
	}
	.hero-h1 {
		font-weight: 560;
		font-variation-settings: "opsz" 72;
		font-size: clamp(2.5rem, 1.35rem + 3.7vw, 4.9rem);
		line-height: 1.04;
		margin-top: 1.1rem;
		max-width: 8.6em;
	}
	.hero-lede {
		margin-top: 1.4rem;
		max-width: 36ch;
		font-size: var(--text-body-lg);
	}
	.hero-ctas {
		margin-top: 2.2rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.9rem;
	}
	/* the air above the counter: flexes with viewport height; objects are
	   anchored to its bottom edge = the counter's top edge (the shelf
	   line), so they always stand on the line at any scene height */
	.hero-shelf {
		position: relative;
		flex: 1;
		z-index: 1;
		pointer-events: none;
	}
	.hero-obj {
		position: absolute;
		bottom: 0;
		margin: 0;
	}
	/* contact shadow ON the shelf — what makes a print stand, not float */
	.hero-obj::after {
		content: "";
		position: absolute;
		left: 5%;
		right: 5%;
		bottom: -8px;
		height: 14px;
		background: radial-gradient(50% 62% at 50% 50%, rgb(60 42 32 / .30), transparent 72%);
		z-index: -1;
	}
	.hero-obj :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 3px;
		box-shadow: 0 0 0 1px rgb(60 42 32 / .08), 0 16px 30px -18px rgb(60 42 32 / .35);
	}
	.hero-obj--figura { right: 30.5%; width: clamp(175px, 14vw, 200px); z-index: 1; }
	.hero-obj--main   { right: clamp(1.5rem, 7vw, 7rem); width: clamp(270px, 23vw, 335px); z-index: 3; }
	/* TEAM_043 (Q4-04): принт втянут целиком в кадр — срез ~35%
	   читался случайным («ни там ни тут»), а ≥50% убивал читаемость
	   третьего продукта. Три читаемых объекта на прилавке. */
	.hero-obj--queso  { right: clamp(0.75rem, 1.5vw, 1.5rem); width: clamp(140px, 12vw, 180px); z-index: 4; }
	.hero-note {
		position: absolute;
		top: 11%;
		left: -3.4rem;
		transform: rotate(-3deg);
		font-size: clamp(1.25rem, 1rem + 0.9vw, 1.7rem);
		white-space: nowrap;
	}
	/* TEAM_043 (Q2-06): вторая бирка «la de queso» — только мобильная
	   shelf-композиция; на десктопе третий объект мелкий, бирка бы
	   шумела */
	.hero-note--queso {
		display: none;
		top: auto;
		left: auto;
		right: -0.35rem;
		bottom: -1.8rem;
		font-size: 1.3rem;
		transform: rotate(-5deg);
	}
	/* TEAM_043 (Q4-04): тихий слой под CTA в «воздухе» полки —
	   рукописное «capa a capa» + стрелка к линии прилавка */
	.hero-floor {
		display: none;
		position: absolute;
		left: clamp(1rem, 5vw, 5rem);
		bottom: clamp(3.5rem, 16svh, 7.5rem);
		flex-direction: column;
		z-index: 1;
	}
	.hero-floor-note {
		font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.8rem);
		color: var(--color-caramel-ink);
		transform: rotate(-4deg);
	}
	.hero-floor-arrow {
		width: clamp(32px, 3vw, 44px);
		margin-left: clamp(3.2rem, 5.5vw, 5.5rem);
		stroke: var(--color-caramel-ink);
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
		opacity: 0.85;
	}
	@media (min-width: 64rem) {
		.hero-floor { display: flex; }
	}
	.hero-counter {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: var(--counter-h);
		background: var(--surface);
		border-top: 1px solid color-mix(in srgb, var(--color-muted) 60%, transparent);
	}
	/* TEAM_043 (Q4-04): столешница получает грань — светлая кромка
	   под линией поверхности + узкая тёмная фаска по нижнему краю;
	   объекты визуально СТОЯТ на камне, полоса = стол, а не фон */
	.hero-counter::before {
		content: "";
		position: absolute;
		top: 1px;
		left: 0;
		right: 0;
		height: clamp(4px, 0.7svh, 8px);
		background: color-mix(in srgb, var(--bg) 50%, var(--surface));
	}
	.hero-counter::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: clamp(12px, 1.9svh, 20px);
		border-top: 1px solid color-mix(in srgb, var(--color-muted) 40%, transparent);
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--dark) 13%, var(--surface)),
			color-mix(in srgb, var(--dark) 23%, var(--surface))
		);
	}
	/* mobile: same counter, own composition — objects spread across the
	   shelf below the copy, figura drops out (crowd on 390px); the note
	   becomes a tag at the print's base so it can't collide with CTAs. */
	@media (max-width: 1023.98px) {
		.hero-scene { --counter-h: 4rem; }
		.hero-copy { padding-top: 2.4rem; }
		.hero-shelf { min-height: 18rem; }
		.hero-obj--figura { display: none; }
		.hero-obj--main { left: 4vw; right: auto; width: 54vw; }
		.hero-obj--queso { right: 8vw; width: 34vw; }
		.hero-note { top: auto; bottom: -0.9rem; left: 0.9rem; }
		/* TEAM_043 (Q2-06): вторая бирка на мобильной композиции —
		   оба продукта на полке подписаны как ценники витрины */
		.hero-note--queso { display: block; left: auto; right: -0.35rem; bottom: -1.8rem; }
	}

	/* — S02 «el corte» — */
	/* TEAM_043 (Q3-02): rotate(-0.6deg) у .band-note давал ~1.5px
	   горизонтальный overflow на 390 — клипим на секции */
	.s02 { overflow-x: clip; }
	.s02-wrap { position: relative; }
	.s02-text { max-width: 60ch; }
	.s02-body { margin-top: 1.4rem; }
	/* TEAM_043 (Q1-02): малая деталь справа от абзаца — сидит в зазоре
	   у края ленты, не трогая колонку текста */
	.s02-aside {
		display: none;
		position: absolute;
		right: 2%;
		bottom: 0;
		width: clamp(58px, 6vw, 76px);
		stroke: color-mix(in srgb, var(--color-caramel-ink) 80%, transparent);
