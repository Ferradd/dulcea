---
// TEAM_027: G.9 canon footer — dark band: wordmark + «tartas artesanales ·
// Cartagena, Murcia» left; canonical nav + channel line right; small
// copyright below. No badges, no counters.
import site from '../data/sections.json';

interface Props {
	class?: string;
}

const { class: cls = '' } = Astro.props;
const { brand, header, footer } = site.global;
---

<footer class:list={['colophon', cls]}>
	<div class="mx-auto max-w-6xl px-5 py-14 md:py-16">
		<div class="colo-grid">
			<div>
				<p class="wordmark colo-wordmark">{brand.wordmark}</p>
				<p class="colo-line">{footer.line}</p>
			</div>
			<div class="colo-right">
				<nav class="colo-nav" aria-label="Pie">
					{header.nav.map((l) => <a href={l.href}>{l.label}</a>)}
				</nav>
				<p class="colo-channel">
					Pedidos por DM · <a href={brand.instagram} target="_blank" rel="noopener">{brand.handle}</a>
				</p>
			</div>
		</div>
		<hr class="colo-rule" aria-hidden="true" />
		<p class="colo-meta">{footer.copyright}</p>
	</div>
</footer>

<style>
	.colophon {
		background: var(--dark);
		color: var(--color-cream);
	}
	.colo-grid {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 2.5rem;
		flex-wrap: wrap;
	}
	.colo-wordmark {
		font-size: 1.9rem;
		color: var(--color-cream);
	}
	.colo-line {
		margin-top: 0.6rem;
		color: var(--color-muted-light);
		font-size: 0.9rem;
	}
	.colo-right { text-align: right; }
	.colo-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 1.4rem;
	}
	.colo-nav a {
		/* TEAM_045 Q2-01: hit-area ≥44px; underline → text-decoration,
		   чтобы оставаться под текстом при выросшем боксе. */
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: 0.76rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-cream);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 0.25em;
	}
	.colo-nav a:hover {
		color: var(--color-caramel-glow);
		text-decoration-color: var(--color-caramel-glow);
	}
	.colo-channel {
		margin-top: 1.1rem;
		font-size: 0.85rem;
		color: var(--color-muted-light);
	}
	.colo-channel a {
		color: var(--color-caramel-glow);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.colo-rule {
		margin-top: 2.5rem;
		border: 0;
		border-top: 1px solid color-mix(in srgb, var(--color-muted) 40%, transparent);
	}
	.colo-meta {
		margin-top: 1.25rem;
		font-size: 0.78rem;
		color: var(--color-muted-light);
	}
	@media (max-width: 640px) {
		.colo-right { text-align: left; }
		.colo-nav { justify-content: flex-start; }
	}
</style>
