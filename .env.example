# dulcea.cake — env vars
#
# PUBLIC_FORM_ENDPOINT — optional. Full URL of a Formspree/Web3Forms-style
# form backend that accepts `POST` with `FormData` (multipart) and answers
# JSON when sent `Accept: application/json`. Any key/token the provider needs
# travels inside the URL itself — it is public client-side config, not a
# secret (the form is a static site; keep provider spam settings tight).
#
# Examples:
#   PUBLIC_FORM_ENDPOINT=https://formspree.io/f/<tu-id>
#   PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit   (needs access_key —
#     add a hidden <input name="access_key"> in contacto.astro if you use it)
#
# UNSET / EMPTY = the contacto S02 «¿Lo prefieres por escrito?» section is
# not rendered at all (MF-3 launch gate — the DM composer above already
# covers the need). Set a real endpoint and the section ships live.
PUBLIC_FORM_ENDPOINT=
